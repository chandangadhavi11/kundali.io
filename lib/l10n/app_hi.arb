  "phala_theme_sun": "आत्म-साक्षात्कार, अधिकार और पहचान की अवधि। आत्मा अपने वास्तविक स्वरूप को व्यक्त करना चाहती है।",
  "phala_theme_moon": "भावनात्मक विकास, पालन-पोषण और अंतर्ज्ञान की अवधि। मन शांति और मातृ सुख चाहता है।",
  "phala_theme_mars": "ऊर्जा, साहस और कार्रवाई की अवधि। योद्धा भावना चुनौतियों को जीतने के लिए जागृत होती है।",
  "phala_theme_mercury": "बुद्धि, संचार और सीखने की अवधि। मन ज्ञान और अभिव्यक्ति की खोज करता है।",
  "phala_theme_jupiter": "ज्ञान, विकास और आशीर्वाद की अवधि। आत्मा उच्च ज्ञान और धर्म की खोज करती है।",
  "phala_theme_venus": "प्रेम, विलासिता और रचनात्मकता की अवधि। हृदय सौंदर्य और सामंजस्यपूर्ण संबंध चाहता है।",
  "phala_theme_saturn": "कर्म, अनुशासन और परिवर्तन की अवधि। धैर्य और दृढ़ता से सबक मिलते हैं।",
  "phala_theme_rahu": "महत्वाकांक्षा, सांसारिक इच्छाओं और अपरंपरागत विकास की अवधि। आत्मा भौतिक विस्तार चाहती है।",
  "phala_theme_ketu": "आध्यात्मिकता, वैराग्य और मुक्ति की अवधि। आत्मा आंतरिक शांति और मोक्ष चाहती है।",
  
