  "houses_withSign": "{sign} राशि और {lord} स्वामी के साथ, यह भाव आपकी कुंडली में {sign} ऊर्जा के गुण धारण करता है।",

  "houses_1_desc": "प्रथम भाव, जिसे लग्न भी कहते हैं, आपके स्वयं, शारीरिक शरीर, रूप-रंग और आप दुनिया के सामने कैसे प्रस्तुत होते हैं, इसका प्रतिनिधित्व करता है। यह कुंडली का सबसे व्यक्तिगत भाव है।",
  "houses_2_desc": "द्वितीय भाव धन, पारिवारिक मूल्य, वाणी और प्रारंभिक बचपन को नियंत्रित करता है। यह धन, संपत्ति और संवाद के साथ आपके संबंध को दर्शाता है।",
  "houses_3_desc": "तृतीय भाव संचार, छोटी यात्राओं, भाई-बहनों और साहस को नियंत्रित करता है। यह आपकी मानसिक शक्ति, कौशल और अभिव्यक्ति क्षमता का प्रतिनिधित्व करता है।",
  "houses_4_desc": "चतुर्थ भाव आपकी माता, घर, भावनात्मक नींव और आंतरिक शांति का प्रतिनिधित्व करता है। यह आपकी जड़ों, घरेलू खुशी और संपत्ति मामलों को दर्शाता है।",
  "houses_5_desc": "पंचम भाव रचनात्मकता, संतान, प्रेम और बुद्धि को नियंत्रित करता है। यह आपकी रचनात्मक अभिव्यक्ति, सट्टा लाभ और पूर्व जन्म के पुण्य का प्रतिनिधित्व करता है।",
  "houses_6_desc": "षष्ठ भाव शत्रुओं, रोगों, ऋणों और दैनिक कार्य से संबंधित है। यह उन चुनौतियों को दर्शाता है जिन्हें आपको पार करना है और सेवा की क्षमता।",
  "houses_7_desc": "सप्तम भाव विवाह, साझेदारी और व्यापारिक संबंधों को नियंत्रित करता है। यह आपके जीवनसाथी, अनुबंधों और दूसरों से कैसे संबंध रखते हैं, इसका प्रतिनिधित्व करता है।",
  "houses_8_desc": "अष्टम भाव परिवर्तन, आयु, विरासत और छिपे मामलों को नियंत्रित करता है। यह गहरे परिवर्तन, गुप्त ज्ञान और संयुक्त संसाधनों का प्रतिनिधित्व करता है।",
  "houses_9_desc": "नवम भाव उच्च शिक्षा, आध्यात्मिकता, भाग्य और लंबी यात्राओं का प्रतिनिधित्व करता है। यह आपके पिता, गुरु और दार्शनिक दृष्टिकोण को दर्शाता है।",
  "houses_10_desc": "दशम भाव करियर, स्थिति, प्रतिष्ठा और उपलब्धियों को नियंत्रित करता है। यह आपके व्यावसायिक जीवन, अधिकारियों और सार्वजनिक स्थिति का प्रतिनिधित्व करता है।",
  "houses_11_desc": "एकादश भाव लाभ, मित्रता, आकांक्षाओं और बड़े भाई-बहनों को नियंत्रित करता है। यह आपके सामाजिक नेटवर्क, आशाओं और नियमित आय का प्रतिनिधित्व करता है।",
  "houses_12_desc": "द्वादश भाव हानि, आध्यात्मिकता, विदेश और मोक्ष से संबंधित है। यह खर्च, एकांत और मोक्ष की यात्रा का प्रतिनिधित्व करता है।",

